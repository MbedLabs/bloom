BLOOM_ENV=production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/bloom_db
SECRET_KEY=replace-with-a-strong-random-secret
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000
BUD_APP_URL=http://localhost:8001
BLOOM_APP_URL=http://localhost:8000
TESTSTATION_APP_URL=http://localhost:8001
RUN_STARTUP_DATA_REPAIR=false
AUTO_SEED_ADMIN=false
ENABLE_DOCS=false
BLOOM_DOTENV_DISABLED=0
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Bloom
SMTP_REPLY_TO=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
INVITE_TOKEN_TTL_HOURS=72
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_FULL_NAME=Bloom Admin
