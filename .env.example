# Image tag to run. Production: pin an immutable version (e.g. 1.0.0) or use
# `stable` (newest stable release). `latest` is the rolling dev build from main
BLOOM_VERSION=stable
BLOOM_ENV=production
POSTGRES_USER=bloom
POSTGRES_PASSWORD=
POSTGRES_DB=bloom
SECRET_KEY=
# Required only for optional Bud result sync. Use an independent random value
# of at least 32 characters.
SERVICE_TOKEN_PEPPER=
# Fernet key encrypting GitHub/GitLab tokens and webhook secrets at rest.
# Required only when GitHub/GitLab issue synchronization is configured. Bloom
# starts without it; only tracker credential operations fail closed.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=
# Public URL of this Bloom instance. Used in the links Bloom emails (invites,
# email verification, password resets) and in campaign links.
APP_BASE_URL=http://localhost:8000
BUD_APP_URL=
BLOOM_APP_URL=http://localhost:8000
TESTSTATION_APP_URL=
# Browser origins allowed to call the API (JSON array). Set your public URL(s) in production.
CORS_ORIGINS=["https://bloom.example.com"]
RUN_STARTUP_DATA_REPAIR=false
AUTO_SEED_ADMIN=false
ENABLE_DOCS=false
BLOOM_DOTENV_DISABLED=1
# SMTP is optional for a single pre-seeded administrator, but required for
# invitations, password resets, and approved email changes.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_REPLY_TO=support@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
INVITE_TOKEN_TTL_HOURS=72
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
# Access and refresh token lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Send auth cookies only over HTTPS. Defaults to true in production.
AUTH_COOKIE_SECURE=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Bloom Admin
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
REQIF_MAX_REQUEST_BYTES=26214400
REQIF_MAX_MEMBER_BYTES=26214400
REQIF_MAX_ARCHIVE_ENTRIES=100
REQIF_MAX_COMPRESSION_RATIO=20
REQIF_MAX_OBJECTS=999
REQIF_MAX_RELATIONS=10000
REQIF_MAX_HIERARCHY_DEPTH=100
REQIF_PROCESSING_TIMEOUT_SECONDS=60
REQIF_IMPORTS_PER_15_MINUTES=5
REQIF_STREAM_CHUNK_BYTES=1048576
BLOOM_ATTACHMENT_DIR=/app/attachments
BLOOM_MAX_ATTACHMENT_SIZE=26214400
BLOOM_MAX_DOCUMENT_ATTACHMENT_BYTES=262144000
BLOOM_MIN_ATTACHMENT_FREE_BYTES=1073741824
BLOOM_ATTACHMENT_UPLOADS_PER_15_MINUTES=10
BLOOM_MAX_CONCURRENT_ATTACHMENT_UPLOADS_PER_USER=1
# Advanced: JSON array of accepted attachment MIME types. Unset uses the built-in allowlist.
# ALLOWED_ATTACHMENT_MIME_TYPES=["application/pdf","application/json"]
