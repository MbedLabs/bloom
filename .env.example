# Image tag to run. Production: pin an immutable version (e.g. 1.0.0) or use
# `stable` (newest stable release). `latest` is the rolling dev build from main
# and must NOT be used in production.
BLOOM_VERSION=stable
BLOOM_ENV=production
POSTGRES_USER=bloom
POSTGRES_PASSWORD=
POSTGRES_DB=bloom
SECRET_KEY=
# Independent HMAC pepper for opaque service credentials (minimum 32 random characters).
SERVICE_TOKEN_PEPPER=
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8000
BUD_APP_URL=
BLOOM_APP_URL=http://localhost:8000
TESTSTATION_APP_URL=
RUN_STARTUP_DATA_REPAIR=false
AUTO_SEED_ADMIN=false
ENABLE_DOCS=false
BLOOM_DOTENV_DISABLED=1
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_REPLY_TO=support@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30
INVITE_TOKEN_TTL_HOURS=72
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_HOURS=2
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Bloom Admin
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
REQIF_MAX_REQUEST_BYTES=26214400
REQIF_MAX_MEMBER_BYTES=26214400
REQIF_MAX_ARCHIVE_ENTRIES=100
REQIF_MAX_COMPRESSION_RATIO=20
REQIF_MAX_OBJECTS=999
REQIF_MAX_RELATIONS=10000
REQIF_MAX_HIERARCHY_DEPTH=100
REQIF_PROCESSING_TIMEOUT_SECONDS=60
REQIF_IMPORTS_PER_15_MINUTES=5
REQIF_STREAM_CHUNK_BYTES=1048576
